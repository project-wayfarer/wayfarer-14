mime-summon-hands-full = You need a free hand.

mime-finger-gun-draw-self = You draw your finger guns!
mime-finger-gun-draw-others = {CAPITALIZE(THE($user))} draws {POSS-ADJ($user)} finger guns!
mime-finger-gun-put-away-self = You holster your finger guns.
mime-finger-gun-put-away-others = {CAPITALIZE(THE($user))} holsters {POSS-ADJ($user)} finger guns.
mime-finger-gun-fire-others = {CAPITALIZE(THE($user))} fires {POSS-ADJ($user)} finger guns!

mime-invisible-box-find-self = You mime an invisible box!
mime-invisible-box-find-others = {CAPITALIZE(THE($user))} mimes an invisible box!
mime-invisible-box-put-away-self = You put the invisible box away.
mime-invisible-box-put-away-others = {CAPITALIZE(THE($user))} puts the invisible box away.

mime-invisible-box-insert-others = {CAPITALIZE(THE($user))} puts {THE($item)} into the invisible box!
mime-invisible-box-remove-others = {CAPITALIZE(THE($user))} takes {THE($item)} out of the invisible box!
