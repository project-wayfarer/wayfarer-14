<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     SetSize="400 500"
                     MinSize="400 500"
                     Title="{Loc 'library-console-menu-title'}">
    <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True" VerticalExpand="True">
        <TabContainer Name="MainTabContainer" VerticalExpand="True" HorizontalExpand="True">
            <!-- Tab 0: Upload -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="4">
                <Label Text="{Loc 'library-console-upload-section-label'}"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 4" />
                <Label Text="{Loc 'library-console-title-label'}" HorizontalAlignment="Left" />
                <LineEdit Name="TitleEdit"
                          PlaceHolder="{Loc 'library-console-title-placeholder'}"
                          HorizontalExpand="True"
                          Margin="0 0 0 4" />
                <Label Text="{Loc 'library-console-author-label'}" HorizontalAlignment="Left" />
                <LineEdit Name="AuthorEdit"
                          PlaceHolder="{Loc 'library-console-author-placeholder'}"
                          HorizontalExpand="True"
                          Margin="0 0 0 4" />
                <!-- Wayfarer -->
                <Label Text="{Loc 'library-console-warning-label'}" HorizontalAlignment="Left" />
                <LineEdit Name="WarningEdit"
                          PlaceHolder="{Loc 'library-console-warning-placeholder'}"
                          HorizontalExpand="True"
                          Margin="0 0 0 4" />
                <CheckBox Name="IsNSFW" Access="Public" Text="{Loc 'library-console-upload-nsfw'}" />
                <CheckBox Name="IsPublishable" Access="Public" Text="{Loc 'library-console-upload-can-published'}" />
                <!-- End Wayfarer -->
                <Button Name="UploadBookButton"
                        Text="{Loc 'library-console-upload-book-button'}"
                        HorizontalExpand="True"
                        Margin="0 0 0 4" />
            </BoxContainer>
            <!-- Tab 1: Browse -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="4">
                <LineEdit Name="SearchEdit"
                          PlaceHolder="{Loc 'library-console-search-placeholder'}"
                          HorizontalExpand="True"
                          Margin="0 0 0 4" />
                <!-- Wayfarer -->
                <BoxContainer Orientation="Horizontal" Margin="4,4,4,4">
                    <Label Text="{Loc 'library-console-browse-sort'}" MinWidth="80"/>
                    <OptionButton Name="SortOrder" HorizontalExpand="True" />
                </BoxContainer>
                <CheckBox Name="ShowNSFW" Access="Public" Text="{Loc 'library-console-show-nsfw'}" />
                <CheckBox Name="ShowMine" Access="Public" Text="{Loc 'library-console-show-mine'}" />
                <!-- End Wayfarer -->
                <Label Name="BrowseEmptyLabel"
                       Text="{Loc 'library-console-browse-empty'}"
                       HorizontalAlignment="Center"
                       Visible="False"
                       Margin="0 0 0 4" />
                <ItemList Name="BookList"
                          SelectMode="Single"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          Margin="0 0 0 4" />
                <!-- Wayfarer -->
                <RichTextLabel Name="ContentWarnings"
                       Text=""
                       HorizontalAlignment="Center"
                       Visible="True"
                       Margin="0 0 0 4" />
                <!-- End Wayfarer -->
                <Button Name="DownloadBookButton"
                        Text="{Loc 'library-console-download-book-button'}"
                        HorizontalExpand="True"
                        Margin="0 0 0 4" />
                <!-- Wayfarer -->
                <Button Name="ReUploadBookButton"
                        Text="{Loc 'library-console-reupload-book-button'}"
                        HorizontalExpand="True"
                        Margin="0 0 0 4"
                        Visible="False"/>
                <Button Name="ReUploadBookButtonConf"
                        Text="{Loc 'library-console-reupload-book-button-conf'}"
                        HorizontalExpand="True"
                        Margin="0 0 0 4"
                        Visible="False"/>
                <Button Name="DeleteBookButton"
                        Text="{Loc 'library-console-delete-book-button'}"
                        HorizontalExpand="True"
                        Margin="0 0 0 4"
                        Visible="False"/>
                <Button Name="DeleteBookButtonConf"
                        Text="{Loc 'library-console-delete-book-button-conf'}"
                        HorizontalExpand="True"
                        Margin="0 0 0 4"
                        Visible="False"/>
                <!-- End Wayfarer -->
            </BoxContainer>
        </TabContainer>
    </BoxContainer>
</controls:FancyWindow>
