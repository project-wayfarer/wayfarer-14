<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:xNamespace="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:style="clr-namespace:Content.Client.Stylesheets"
                      Title="{Loc 'wf-radio-console-menu-title'}"
                      MinSize="320 480"
                      SetSize="340 560">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="8">

        <PanelContainer>
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="{xNamespace:Static style:StyleNano.PanelDark}" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="8">
                <SpriteView Name="ConsoleIcon" OverrideDirection="South" Scale="2 2" SetSize="64 64" VerticalAlignment="Center" />
                <BoxContainer Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True" VerticalAlignment="Center">
                    <Label Text="{Loc 'wf-radio-console-menu-name-label'}" StyleClasses="LabelKeyText" />
                    <LineEdit Name="NameLineEdit" HorizontalExpand="True" />
                    <Label Text="{Loc 'wf-radio-console-menu-channel-label'}" StyleClasses="LabelKeyText" Margin="0 4 0 0" />
                    <LineEdit Name="ChannelLineEdit" HorizontalExpand="True" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <Label Text="{Loc 'wf-radio-console-menu-presets-label'}" StyleClasses="LabelKeyText" HorizontalAlignment="Center" />
        <PanelContainer VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="{xNamespace:Static style:StyleNano.PanelDark}" />
            </PanelContainer.PanelOverride>
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="PresetList" Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True" Margin="4" />
            </ScrollContainer>
        </PanelContainer>

        <Button Name="BroadcastButton" ToggleMode="True" Text="{Loc 'wf-radio-console-menu-broadcast-off'}" />
    </BoxContainer>
</controls:FancyWindow>
