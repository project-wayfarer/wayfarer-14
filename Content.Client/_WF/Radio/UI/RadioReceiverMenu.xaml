<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:xNamespace="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:style="clr-namespace:Content.Client.Stylesheets"
                      Title="{Loc 'wf-radio-receiver-menu-title'}"
                      MinSize="290 340"
                      SetSize="290 380">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="8">

        <PanelContainer>
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="{xNamespace:Static style:StyleNano.PanelDark}" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="8">
                <SpriteView Name="RadioIcon" OverrideDirection="South" Scale="2 2" SetSize="48 48" VerticalAlignment="Center" />
                <BoxContainer Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True" VerticalAlignment="Center">
                    <Label Name="TunedChannelLabel" StyleClasses="LabelKeyText" />
                    <Label Name="TunedConsoleLabel" StyleClasses="LabelSubText" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <Label Text="{Loc 'wf-radio-receiver-menu-list-label'}" StyleClasses="LabelKeyText" />
        <PanelContainer VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="{xNamespace:Static style:StyleNano.PanelDark}" />
            </PanelContainer.PanelOverride>
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="ConsoleList" Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True" Margin="4" />
            </ScrollContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalAlignment="Center">
            <Label Text="{Loc 'wf-radio-receiver-menu-volume-label'}" />
            <Slider Name="VolumeSlider" HorizontalExpand="True" MinValue="0" MaxValue="100" Value="100" />
            <Label Name="VolumeValueLabel" MinSize="44 0" HorizontalAlignment="Right" />
        </BoxContainer>

        <Button Name="PowerButton" ToggleMode="True" Text="{Loc 'wf-radio-receiver-menu-power-off'}" />
    </BoxContainer>
</controls:FancyWindow>
