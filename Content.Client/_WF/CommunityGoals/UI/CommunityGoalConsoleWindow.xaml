<controls:FancyWindow
        xmlns="https://spacestation14.io"
        xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
        Title="Community Goals Terminal" MinSize="600 500">
    <BoxContainer Orientation="Vertical">

        <!-- Item contribution slot -->
        <BoxContainer Name="ContributionPanel" Orientation="Horizontal" Margin="8 6">
            <Label Text="Insert item:" Margin="0 0 8 0"/>
            <PanelContainer Name="SlotPanel" MinSize="240 28" HorizontalExpand="True">
                <Label Name="SlotLabel" Text="— empty —" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontColorOverride="#888888"/>
            </PanelContainer>
            <Button Name="ContributeButton" Text="Contribute" MinWidth="100" Margin="8 0 0 0" Disabled="True"/>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="6 0 6 4"/>

        <!-- Goals list -->
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Name="GoalsList" Orientation="Vertical" Margin="6"/>
        </ScrollContainer>

    </BoxContainer>
</controls:FancyWindow>
