<controls:FancyWindow
        xmlns="https://spacestation14.io"
        xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
        Title="Community Goals Terminal" MinSize="620 540">
    <BoxContainer Orientation="Vertical">

        <!-- Staging area header -->
        <BoxContainer Orientation="Horizontal" Margin="8 6 8 2">
            <Label Text="Staging Area" FontColorOverride="#ddddaa" Margin="0 0 8 0" VerticalAlignment="Center"/>
            <Label Name="StagingCount" Text="0 items" FontColorOverride="#888888" HorizontalExpand="True" VerticalAlignment="Center"/>
            <Button Name="CommitButton" Text="Contribute All" MinWidth="120" Margin="4 0" Disabled="True"/>
            <Button Name="ClearButton" Text="Return Items" MinWidth="100" Disabled="True"/>
        </BoxContainer>

        <!-- Instruction hint -->
        <Label Name="HintLabel" Text="Use items on this terminal to stage them for contribution."
               FontColorOverride="#666666" Margin="10 0 8 2"/>

        <!-- Staged items list (scrollable, capped height) -->
        <ScrollContainer MinHeight="60" MaxHeight="180" Margin="6 0 6 4">
            <BoxContainer Name="StagingList" Orientation="Vertical" Margin="2"/>
        </ScrollContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="6 0 6 4"/>

        <!-- Goals list -->
        <Label Text="Active Goals" FontColorOverride="#aaffaa" Margin="8 2"/>
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Name="GoalsList" Orientation="Vertical" Margin="6"/>
        </ScrollContainer>

    </BoxContainer>
</controls:FancyWindow>
